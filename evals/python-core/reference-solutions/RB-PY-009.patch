+++ b/tests/test_reservations.py
@@ -0,0 +1,21 @@
+import pytest
+
+from inventory import InventoryService
+
+
+def test_reserve_retry_and_cancel():
+    service = InventoryService({"a": 5, "b": 3})
+    record = service.reserve("one", [("b", 1), ("a", 2)])
+    assert record.items == (("a", 2), ("b", 1))
+    assert service.reserve("one", [("a", 2), ("b", 1)]) == record
+    assert service.stock_snapshot() == {"a": 3, "b": 2}
+    assert service.cancel("one").status == "cancelled"
+    assert service.stock_snapshot() == {"a": 5, "b": 3}
+
+
+def test_rejection_keeps_stock_and_id_available():
+    service = InventoryService({"a": 5, "b": 1})
+    with pytest.raises(ValueError):
+        service.reserve("one", [("a", 2), ("b", 2)])
+    assert service.stock_snapshot() == {"a": 5, "b": 1}
+    assert service.reserve("one", [("a", 1)]).status == "active"
