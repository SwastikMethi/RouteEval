diff --git a/transports/_registry.py b/transports/_registry.py
new file mode 100644
--- /dev/null
+++ b/transports/_registry.py
@@ -0,0 +1,10 @@
+from .errors import UnknownTransport
+from .implementations import MemoryTransport, ConsoleTransport, FileTransport
+
+factories = {"memory": MemoryTransport, "console": ConsoleTransport, "file": FileTransport}
+
+def resolve(name):
+    try:
+        return factories[name]
+    except KeyError:
+        raise UnknownTransport(name) from None
