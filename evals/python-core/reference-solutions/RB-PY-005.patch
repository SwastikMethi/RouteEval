diff --git a/settings/resolver.py b/settings/resolver.py
--- a/settings/resolver.py
+++ b/settings/resolver.py
@@ -1,6 +1,32 @@
+from collections.abc import Mapping
 from .merge import merge_settings
-from .schema import DEFAULTS
+from .schema import DEFAULTS, ConfigError, coerce_value
 from .sources import read_environment
 
+def _normalize(layer):
+    result = {}
+    if layer is None:
+        return result
+    if not isinstance(layer, Mapping):
+        raise ConfigError("settings: expected a mapping")
+    for key, value in layer.items():
+        if key not in DEFAULTS:
+            raise ConfigError(f"{key}: unknown setting")
+        if value is None:
+            continue
+        if key == "database":
+            if not isinstance(value, Mapping):
+                raise ConfigError("database: expected a mapping")
+            result[key] = {}
+            for child, item in value.items():
+                dotted = f"database.{child}"
+                if child not in DEFAULTS["database"]:
+                    raise ConfigError(f"{dotted}: unknown setting")
+                if item is not None:
+                    result[key][child] = coerce_value(dotted, item)
+        else:
+            result[key] = coerce_value(key, value)
+    return result
+
 def load_config(project=None, env=None, runtime=None):
-    return merge_settings(DEFAULTS, runtime, read_environment(env or {}), project)
+    return merge_settings(DEFAULTS, _normalize(project), read_environment(env or {}), _normalize(runtime))
