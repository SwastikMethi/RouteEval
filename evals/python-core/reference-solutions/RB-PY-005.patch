diff --git a/settings/schema.py b/settings/schema.py
--- a/settings/schema.py
+++ b/settings/schema.py
@@ -1,3 +1,5 @@
+import re
+
 DEFAULTS = {"debug": False, "retries": 3, "timeout": 30,
             "database": {"host": "localhost", "port": 5432}}
 
@@ -6,7 +8,26 @@
 
 def coerce_value(key, value):
     if key == "debug":
-        return bool(value)
+        if isinstance(value, bool):
+            return value
+        if isinstance(value, str):
+            word = value.strip().lower()
+            if word in ("true", "1", "yes", "on"):
+                return True
+            if word in ("false", "0", "no", "off"):
+                return False
+        raise ConfigError(f"{key}: expected a boolean")
     if key in ("retries", "timeout", "database.port"):
-        return int(value)
-    return value
+        if isinstance(value, str) and re.fullmatch(r"[+-]?[0-9]+", value.strip()):
+            value = int(value)
+        if type(value) is not int:
+            raise ConfigError(f"{key}: expected an integer")
+        minimum = 0 if key == "retries" else 1
+        if value < minimum or key == "database.port" and value > 65535:
+            raise ConfigError(f"{key}: integer outside allowed range")
+        return value
+    if key == "database.host":
+        if isinstance(value, str) and value:
+            return value
+        raise ConfigError(f"{key}: expected a nonempty string")
+    raise ConfigError(f"{key}: unknown setting")
